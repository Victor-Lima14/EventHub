# Porta em que o servidor escuta.
# O Render atribui a porta automaticamente via variável de ambiente PORT.
# Não é necessário definir esta variável no painel do Render.
PORT=3000

# Ambiente de execução da aplicação (development | production)
NODE_ENV=development

# Chave secreta para assinatura e verificação dos tokens JWT.
# OBRIGATÓRIO: use uma string longa, aleatória e segura em produção.
# Nunca compartilhe ou versione este valor.
JWT_SECRET=sua_chave_secreta_jwt_aqui_use_uma_string_longa_e_aleatoria

# Caminho para o arquivo do banco de dados SQLite.
DATABASE_FILE=database/db.sqlite

# URL de origem do frontend (para configuração do CORS).
# Em produção, defina com o domínio real do Vercel (ex: https://meu-app.vercel.app).
# Em desenvolvimento local, use http://localhost:5173 (ou a porta do seu dev server).
FRONTEND_URL=http://localhost:5173
